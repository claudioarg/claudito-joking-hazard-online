{
  "name": "joking-hazard-online",
  "version": "1.0.0",
  "description": "Joking Hazard card game - online multiplayer",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test/smoke.js",
